+static bool ShouldDumpSlippiPlaybackImageFrame()
+{
+	if (!g_playbackStatus || !g_replayComm)
+		return false;
+	if (!g_playbackStatus->inSlippiPlayback || g_playbackStatus->isHardFFW ||
